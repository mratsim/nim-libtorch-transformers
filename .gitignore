# Build artifacts shall be put in an ignored build/ directory
# Ignore dynamic, static libs and libtool archive files
# -----------------------------------------------------------------------------------------
build/
*.so
*.so.*
*.dylib
*.a
*.lib
*.la
*.dll
*.exe
*.out

# Nim
# -----------------------------------------------------------------------------------------
nimcache/

# Vendored workspace/libtorch C++ distribution — fetched by
# workspace/libtorch/vendor/libtorch_installer.nim, machine-local, never committed
# (mirrors tattletale workspace/libtorch/.gitignore)
workspace/libtorch/vendor/libtorch

# Model checkpoints are machine-local, placed or symlinked under
# tests/hf_models by the machine's operator, never committed
# (a committed link is a leak). Regenerate the links per machine.
workspace/transformers/tests/hf_models/*
!workspace/transformers/tests/hf_models/.gitkeep

# MacOS
# -----------------------------------------------------------------------------------------
*.dylib.dSYM/

# Swap or debug
# -----------------------------------------------------------------------------------------
*.swp
*~

# Code editors & agents
# -----------------------------------------------------------------------------------------
.idea
.vscode

# Python devops
# -----------------------------------------------------------------------------------------
.venv
.ruff_cache

# Python artifacts
# -----------------------------------------------------------------------------------------
*.pt
__pycache__/
